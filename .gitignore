# macOS
.DS_Store

# Python cache
__pycache__/
*.py[cod]

# Local runtime state
memory/*.sqlite
skills/agmsg/db/*.db
skills/agmsg/db/*.db-shm
skills/agmsg/db/*.db-wal

# AI/session history is local evidence, not reusable public source.
.codex-history/
.specstory/
Session-History/
Session-History-Archive/
conversation-export*.json
gemini-conversation-*.json
*-this-session-is-being-continued-from-*

# Archives and point-in-time safety copies are kept locally, not in git.
*.zip
backups/
backup/
*.bak
*.backup
*.backup_*

# Virtual environment
.venv/

# Temp plugin installs
temp_local_*/

# Local generated review/staging outputs
tmp/
tmp-csv/
tmp-md/

# Large metadata dumps
enriched-*.csv
docs-*.csv
docs.txt
chozen-land.txt
